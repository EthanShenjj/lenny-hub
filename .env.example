# OpenAI is optional. Search and local browsing work without a key.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ANALYSIS_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Gemini through Google's OpenAI-compatible endpoint:
# AI_PROVIDER=gemini
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_ANALYSIS_MODEL=gemini-3.6-flash
# OPENAI_EMBEDDING_MODEL=gemini-embedding-001

# Absolute paths are optional; defaults point to the three sibling datasets.
LENNY_BASE_DATA_DIR=
LENNY_STARTER_DATA_DIR=
LENNY_TRANSCRIPTS_DIR=
LENNY_DB_PATH=

# The UI calls the maintenance endpoint at startup. Disable to prevent network sync.
LENNY_AUTO_SYNC=true
